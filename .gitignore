# Flutter/Dart 构建产物
build/
dist/
.dart_tool/

# Android Gradle 缓存
android/.gradle/

# Flutter 自动生成的插件文件（包含本机绝对路径，不应提交）
.flutter-plugins
.flutter-plugins-dependencies

# Flutter 依赖
.packages
.pub-cache/
.pub/

# IDE 配置（按需保留）
.idea/
.vscode/

# macOS 系统文件
.DS_Store

# 日志
*.log

# 敏感配置（如有）
*.env
google-services.json
GoogleService-Info.plist

# Android 签名（切勿提交密码或 keystore）
android/key.properties
android/*.jks
android/*.keystore
*.jks
*.keystore

# data/：本地密钥与产物不入库；脚本与示例可提交
data/**
!data/README.md
!data/build.sh
!data/build_all.sh
!data/build_windows.ps1
!data/key.properties.example
!data/apple.properties.example

# Flutter / Xcode local signing inject (written by build script when team is set)
ios/Flutter/Signing.local.xcconfig

# AI 推理中间产物
.ai_workspace/
# golden 测试失败时的 diff 落盘产物
test/widgets/failures/
