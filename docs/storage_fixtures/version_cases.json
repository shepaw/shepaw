{
  "description": "Shared store URI + version ref fixtures for Dart + Rust (docs/storage_protocol_spec.md §1.5；地址不带设备段，docs/pouch_uri_no_device_decision.md). expect: ok | bad_uri | bad_path | ambiguous_ref | not_found. Implemented by milestone M2; v4.2 fixes the contract in advance.",
  "cases": [
    {
      "name": "latest_no_ref",
      "uri": "pouch://artifacts/task-1/out.txt",
      "expect": "ok",
      "space": "artifacts",
      "path": "task-1/out.txt",
      "ref_kind": "latest"
    },
    {
      "name": "hash_ref_short",
      "uri": "pouch://artifacts/task-1/out.txt@3f9a2c1d4e5f6071",
      "expect": "ok",
      "space": "artifacts",
      "path": "task-1/out.txt",
      "ref_kind": "hash",
      "ref_value": "3f9a2c1d4e5f6071"
    },
    {
      "name": "hash_ref_full",
      "uri": "pouch://files/docs/a.md@3f9a2c1d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef",
      "expect": "ok",
      "space": "files",
      "path": "docs/a.md",
      "ref_kind": "hash"
    },
    {
      "name": "hash_ref_too_short",
      "uri": "pouch://artifacts/a.txt@3f9a2c1d",
      "expect": "bad_uri"
    },
    {
      "name": "hash_ref_bad_chars",
      "uri": "pouch://artifacts/a.txt@zzzzzzzzzzzzzzzz",
      "expect": "bad_uri"
    },
    {
      "name": "seq_ref",
      "uri": "pouch://artifacts/task-1/out.txt@v3",
      "expect": "ok",
      "space": "artifacts",
      "path": "task-1/out.txt",
      "ref_kind": "seq",
      "ref_value": "3"
    },
    {
      "name": "seq_ref_v0",
      "uri": "pouch://artifacts/a.txt@v0",
      "expect": "bad_uri"
    },
    {
      "name": "seq_ref_bad",
      "uri": "pouch://artifacts/a.txt@vx",
      "expect": "bad_uri"
    },
    {
      "name": "query_ref_equivalent",
      "uri": "pouch://artifacts/a.txt?ref=v2",
      "expect": "ok",
      "space": "artifacts",
      "path": "a.txt",
      "ref_kind": "seq",
      "ref_value": "2"
    },
    {
      "name": "path_style_uri",
      "uri": "pouch:///files/docs/readme.md",
      "expect": "ok",
      "space": "files",
      "path": "docs/readme.md",
      "ref_kind": "latest"
    },
    {
      "name": "dot_versions_access",
      "uri": "pouch://files/.versions/x",
      "expect": "bad_path"
    },
    {
      "name": "dot_nexuspouch_access",
      "uri": "pouch://artifacts/task-1/.nexuspouch/manifest.json",
      "expect": "bad_path"
    },
    {
      "name": "dot_staging_access",
      "uri": "pouch://artifacts/.staging/u-1/data.bin",
      "expect": "bad_path"
    },
    {
      "name": "traversal_in_path",
      "uri": "pouch://files/a/../../b.txt",
      "expect": "bad_path"
    },
    {
      "name": "custom_space_syntax",
      "uri": "pouch://videos/a.mp4",
      "expect": "ok",
      "space": "videos",
      "path": "a.mp4",
      "ref_kind": "latest",
      "note": "Parse accepts valid custom space syntax; undeclared spaces fail at op/ACL."
    },
    {
      "name": "bad_space",
      "uri": "pouch://Videos/a.mp4",
      "expect": "bad_uri"
    },
    {
      "name": "missing_path",
      "uri": "pouch://artifacts",
      "expect": "bad_uri"
    },
    {
      "name": "hash_prefix_conflict",
      "uri": "pouch://artifacts/a.txt@3f9a2c1d4e5f6071",
      "note": "Contract only: server resolves hash prefix; two versions sharing this prefix MUST return ambiguous_ref. Fixture marks the resolution outcome, not parse validity.",
      "expect": "ambiguous_ref"
    },
    {
      "name": "hash_ref_unknown",
      "uri": "pouch://artifacts/a.txt@3f9a2c1d4e5f6071",
      "note": "Contract only: valid syntax, no matching version in store -> not_found. Implemented in M2.",
      "expect": "not_found"
    }
  ]
}
