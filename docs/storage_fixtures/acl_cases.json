{
  "description": "Shared ACL cases for Dart + Go (docs/storage_protocol_spec.md §3). expect one of: allow, denyUntrusted, denyAcl, denyBadOp.",
  "caller": "aaaaaaaaaaaaaaaa",
  "other": "bbbbbbbbbbbbbbbb",
  "cases": [
    {
      "name": "friend_list",
      "op": "list",
      "trust": "friend",
      "loopback": false,
      "payload": { "space": "artifacts" },
      "expect": "allow"
    },
    {
      "name": "friend_write",
      "op": "write.begin",
      "trust": "friend",
      "loopback": false,
      "payload": { "space": "artifacts" },
      "expect": "allow"
    },
    {
      "name": "friend_list_other_artifacts_no_share",
      "op": "list",
      "trust": "friend",
      "loopback": false,
      "payload": { "space": "artifacts", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "denyAcl"
    },
    {
      "name": "owner_list_own",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "artifacts" },
      "expect": "allow"
    },
    {
      "name": "owner_list_other_artifacts",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "artifacts", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "allow"
    },
    {
      "name": "owner_list_other_backups_no_grant",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "backups", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "denyAcl"
    },
    {
      "name": "owner_list_other_backups_seed",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "backups", "device": "bbbbbbbbbbbbbbbb", "seed": true },
      "expect": "allow"
    },
    {
      "name": "friend_list_other_backups_seed",
      "op": "list",
      "trust": "friend",
      "loopback": false,
      "payload": { "space": "backups", "device": "bbbbbbbbbbbbbbbb", "seed": true },
      "expect": "denyUntrusted"
    },
    {
      "name": "forge_device_on_write",
      "op": "write.begin",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "artifacts", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "denyAcl"
    },
    {
      "name": "recycle_empty_remote",
      "op": "recycle.empty",
      "trust": "owner",
      "loopback": false,
      "payload": {},
      "expect": "denyAcl"
    },
    {
      "name": "recycle_empty_loopback",
      "op": "recycle.empty",
      "trust": "owner",
      "loopback": true,
      "payload": {},
      "expect": "allow"
    },
    {
      "name": "unknown_op",
      "op": "not.a.real.op",
      "trust": "owner",
      "loopback": false,
      "payload": {},
      "expect": "denyBadOp"
    },
    {
      "name": "sync_hello_other_device",
      "op": "sync.hello",
      "trust": "owner",
      "loopback": false,
      "payload": { "device": "bbbbbbbbbbbbbbbb" },
      "expect": "denyAcl"
    },
    {
      "name": "sync_hello_self",
      "op": "sync.hello",
      "trust": "owner",
      "loopback": false,
      "payload": { "device": "aaaaaaaaaaaaaaaa" },
      "expect": "allow"
    },
    {
      "name": "owner_search",
      "op": "search",
      "trust": "owner",
      "loopback": false,
      "payload": { "q": "hello" },
      "expect": "allow"
    },
    {
      "name": "friend_search",
      "op": "search",
      "trust": "friend",
      "loopback": false,
      "payload": { "q": "hello" },
      "expect": "denyUntrusted"
    },
    {
      "name": "owner_events_list",
      "op": "events.list",
      "trust": "owner",
      "loopback": false,
      "payload": { "since": 0 },
      "expect": "allow"
    },
    {
      "name": "friend_events_list",
      "op": "events.list",
      "trust": "friend",
      "loopback": false,
      "payload": { "since": 0 },
      "expect": "denyUntrusted"
    },
    {
      "name": "owner_write_other_workspaces",
      "op": "write.begin",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "workspaces", "device": "bbbbbbbbbbbbbbbb", "path": "ws1/a.txt" },
      "expect": "allow"
    },
    {
      "name": "friend_write_other_workspaces",
      "op": "write.begin",
      "trust": "friend",
      "loopback": false,
      "payload": { "space": "workspaces", "device": "bbbbbbbbbbbbbbbb", "path": "ws1/a.txt" },
      "expect": "denyAcl"
    },
    {
      "name": "owner_write_other_runtime_denied",
      "op": "write.begin",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "runtime", "device": "bbbbbbbbbbbbbbbb", "path": "a1/soul.md" },
      "expect": "denyAcl"
    },
    {
      "name": "owner_list_other_files",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "files", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "allow"
    },
    {
      "name": "owner_list_other_runtime_no_share",
      "op": "list",
      "trust": "owner",
      "loopback": false,
      "payload": { "space": "runtime", "device": "bbbbbbbbbbbbbbbb" },
      "expect": "denyAcl"
    }
  ]
}
